version: '3.8'

services:
  backend:
    environment:
      - LOG_LEVEL=DEBUG
    # Expose debugpy port if debugging in VS Code
    # ports:
    #   - "5678:5678"

  frontend:
    environment:
      - VITE_ENABLE_MOCK_DATA=false
