      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "id": 8,
      "title": "Report Synthesis Velocity by Type",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (report_type) (rate(assistant_reports_generated_total[5m]))",
          "legendFormat": "{{report_type}}",
          "refId": "A"
        }
      ]
