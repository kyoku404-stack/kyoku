      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "id": 9,
      "title": "Assistant Failure & Rejection Rates",
      "type": "timeseries",
      "targets": [
        {
          "expr": "(sum(rate(assistant_workflows_total{status=\"FAILED\"}[5m])) / (sum(rate(assistant_workflows_total[5m])) > 0 or vector(1))) * 100",
          "legendFormat": "Workflow Failure Rate %",
          "refId": "A"
        },
        {
          "expr": "(sum(rate(assistant_approvals_total{decision=\"REJECTED\"}[5m])) / (sum(rate(assistant_approvals_total[5m])) > 0 or vector(1))) * 100",
