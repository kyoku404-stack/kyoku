      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "title": "Hybrid Retrieval Candidate Yield (Dense vs Sparse)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "avg_over_time(rag_dense_candidates_count[5m])",
          "legendFormat": "pgvector Dense Chunks",
          "refId": "A"
        },
        {
          "expr": "avg_over_time(rag_sparse_candidates_count[5m])",
          "legendFormat": "tsvector BM25 Sparse Chunks",
          "refId": "B"
        },
        {
          "expr": "avg_over_time(rag_reranked_candidates_count[5m])",
          "legendFormat": "Final Reranked Context Chunks",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "keep-prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 25, "lineWidth": 1 },
