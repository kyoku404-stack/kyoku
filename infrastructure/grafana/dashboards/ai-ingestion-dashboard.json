      "title": "Pipeline Failure Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "(sum(rate(ai_ingestion_jobs_total{status=\"FAILED\"}[5m])) / sum(rate(ai_ingestion_jobs_total[5m]))) * 100",
          "legendFormat": "Failure %",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "keep-prometheus" },
