        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "title": "Ingestion Queue Backlog",
      "type": "stat",
      "targets": [
        {
          "expr": "ai_ingestion_queue_pending_jobs",
          "legendFormat": "Pending Jobs",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "keep-prometheus" },
