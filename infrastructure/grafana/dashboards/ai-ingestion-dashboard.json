        "graphMode": "area",
        "reduceOptions": { "calcs": ["mean"], "values": false }
      },
      "title": "Processing Throughput",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(ai_ingestion_jobs_total{status=\"COMPLETED\"}[5m])) * 60",
          "legendFormat": "Docs / min",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "keep-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
