# ==============================================================================
# KEEP Backend — Environment Configuration Template (.env.example)
# Placeholders only. Copy to .env or .env.development for local execution.
# ==============================================================================

# Core Application Settings
PROJECT_NAME="KEEP — Knowledge Extraction & Enterprise Platform"
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_STR=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Security & JWT Tokens
SECRET_KEY=replace_with_a_secure_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=keep_user
POSTGRES_PASSWORD=keep_password
POSTGRES_DB=keep_db
DATABASE_URL=postgresql+asyncpg://keep_user:keep_password@localhost:5432/keep_db
SYNC_DATABASE_URL=postgresql+psycopg2://keep_user:keep_password@localhost:5432/keep_db

# Redis Cache & Task Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Storage Path (Local file persistence)
UPLOAD_STORAGE_PATH=./uploads
