# KEEP Frontend Environment Template
# ==================================

# Base URL for Backend REST API
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Application Name & Branding
VITE_APP_NAME=KEEP
VITE_APP_DESCRIPTION="Knowledge Extraction & Enterprise Platform"

# Environment Mode (development | staging | production)
VITE_ENV=development

# Feature Flags
VITE_ENABLE_RAG_STREAMING=true
VITE_ENABLE_KNOWLEDGE_GRAPH=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_MOCK_FALLBACK=false
