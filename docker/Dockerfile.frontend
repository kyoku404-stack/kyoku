# ==============================================================================
# KEEP Enterprise Platform — Frontend Dockerfile
# Multi-stage build supporting development and production Nginx runtime
# ==============================================================================

# Stage 1: Base Node.js environment
FROM node:22-alpine AS base
WORKDIR /app

# Install dependencies based on lockfile / package.json
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci || npm install

# Stage 2: Development target (used by docker-compose in dev mode)
FROM base AS development
ENV NODE_ENV=development
COPY frontend/ .
EXPOSE 3000
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]

# Stage 3: Build production assets
FROM base AS builder
COPY frontend/ .
RUN npm run build

# Stage 4: Production Nginx runtime
FROM nginx:1.27-alpine AS production
COPY --from=builder /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]
