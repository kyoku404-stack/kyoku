# ==============================================================================
# KEEP — Environment Configuration Template (.env.example)
# DO NOT ADD REAL SECRETS TO THIS FILE. USE PLACEHOLDERS ONLY.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=replace_with_a_secure_random_secret_key_in_production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=KEEP

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=keep_user
POSTGRES_PASSWORD=keep_password
POSTGRES_DB=keep_db
DATABASE_URL=postgresql+asyncpg://keep_user:keep_password@localhost:5432/keep_db

# Redis Caching & Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Vector Database Configuration (pgvector / Qdrant)
VECTOR_DB_TYPE=pgvector
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# AI & LLM Engine Configuration
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL_NAME=text-embedding-3-small
LLM_MODEL_NAME=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434

# File Upload & Storage Configuration
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
STORAGE_ROOT=./storage
DEFAULT_STORAGE_QUOTA_BYTES=10737418240
S3_BUCKET_NAME=keep-documents-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# JWT & Security Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Observability, Telemetry & Monitoring (Phase 1.9)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Production Deployment & Reverse Proxy Ingress (Phase 1.10)
PRODUCTION_DOMAIN=localhost
NGINX_PORT_HTTP=80
NGINX_PORT_HTTPS=443
SSL_CERT_PATH=/etc/nginx/certs/fullchain.pem
SSL_KEY_PATH=/etc/nginx/certs/privkey.pem
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
ENABLE_OPENAPI_DOCS=false

